---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { getUiStrings, uiLanguageFromPath } from "@/i18n/ui";

const ui = getUiStrings(uiLanguageFromPath(Astro.url.pathname));

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: ui["tags.description"],
	title: ui["tags.title"],
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">{ui["tags.heading"]}</h1>
	<ul class="space-y-4">
		{
			allTags.map(([tag, val]) => (
				<li class="flex items-center gap-x-2">
					<a
						class="cactus-link inline-block"
						href={`/tags/${tag}/`}
						title={`${ui["tags.viewWithTag"]} ${tag}`}
					>
						&#35;{tag}
					</a>
					<span class="inline-block">
						- {val} {ui[val > 1 ? "tags.postCountPlural" : "tags.postCount"]}
					</span>
				</li>
			))
		}
	</ul>
</PageLayout>
