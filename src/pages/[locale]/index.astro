---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts, getPostsForLocale, translationLocales } from "@/data/post";
import { getUiStrings } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

// English / Japanese landing pages so the header language switcher
// works on non-article pages too (routes: /en/ and /ja/).
export const getStaticPaths = (async () => {
	const locales = translationLocales;
	return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}) satisfies GetStaticPaths;

const locale = Astro.props.locale as "en" | "ja";
const ui = getUiStrings(locale);

// Posts that have a translation in this language (so card links stay inside
// the current language instead of jumping back to the unprefixed Chinese one).
const transBySlug = new Map((await getPostsForLocale(locale)).map((p) => [p.post.id, p.trans]));
const localizedPosts = (await getAllPosts()).filter((p) => transBySlug.has(p.id));

const MAX_POSTS = 10;
const allPostsByDate = localizedPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

// Pinned Posts, set to a max of 3;
const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate
	.values()
	.filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();

// Notes, set to a max of 5
const MAX_NOTES = 5;
const allNotes = await getCollection("note");
const latestNotes = allNotes
	.sort(collectionDateSort)
	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];
---

<PageLayout meta={{ title: ui["home.title"] }}>
	<section>
		<h1 class="title mb-12">{ui["home.greeting"]}</h1>
		<p class="mb-4">
			{ui["home.intro"]}
		</p>
		<SocialList />
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">{ui["home.pinnedPosts"]}</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} title={transBySlug.get(p.id)?.data.title} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href={`/${locale}/posts/`}>{ui["home.posts"]}</a></h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} title={transBySlug.get(p.id)?.data.title} />
					</li>
				))
			}
		</ul>
	</section>
	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href={`/${locale}/notes/`}>{ui["home.notes"]}</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>