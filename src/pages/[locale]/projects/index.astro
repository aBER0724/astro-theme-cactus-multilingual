---
import type { GetStaticPaths } from "astro";
import ProjectCard from "@/components/project/ProjectCard.astro";
import { getPostsForLocale, translationLocales, type Locale } from "@/data/post";
import { getAllProjects, getProjectDescriptions } from "@/data/project";
import { getUiStrings } from "@/i18n/ui";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (() =>
	translationLocales.map((locale) => ({ params: { locale }, props: { locale } }))) satisfies GetStaticPaths;

const locale = Astro.props.locale as Locale;
const ui = getUiStrings(locale);
const projects = await getAllProjects();
const localized = await getPostsForLocale(locale);
const titles = new Map(localized.map(({ post, trans }) => [post.id, trans.data.title]));
const descriptions = await getProjectDescriptions(locale);
const posts = localized.map(({ post }) => post).sort(collectionDateSort);

const meta = {
	title: ui["projects.title"],
	description: ui["projects.description"],
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-3">{ui["projects.title"]}</h1>
	<p class="text-muted mb-12">{ui["projects.description"]}</p>
	<div class="space-y-12">
		{
			projects.map((project) => (
				<ProjectCard
					descriptions={descriptions}
					locale={locale}
					posts={posts.filter((post) => post.data.tags.includes(project.data.name))}
					project={project}
					titles={titles}
				/>
			))
		}
	</div>
</PageLayout>
