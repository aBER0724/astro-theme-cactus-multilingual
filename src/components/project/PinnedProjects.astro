---
import type { CollectionEntry } from "astro:content";
import type { UiLanguage } from "@/i18n/ui";
import { getUiStrings } from "@/i18n/ui";
import { formatProjectStartDate, getProjectHref } from "@/data/project";

interface Props {
	projects: CollectionEntry<"project">[];
	locale: UiLanguage;
}

const { projects, locale } = Astro.props;
const ui = getUiStrings(locale);
const pinnedProjects = projects.filter((project) => project.data.pinned);
---

{
	pinnedProjects.length > 0 && (
		<section>
			<h2 class="title text-accent mb-6 text-xl">
				<a href={locale === "zh" ? "/projects/" : `/${locale}/projects/`}>{ui["home.projects"]}</a>
			</h2>
			<ul class="space-y-4" role="list">
				{pinnedProjects.map((project) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<time class="text-muted min-w-24 font-semibold" datetime={project.data.startDate}>
							{formatProjectStartDate(project.data.startDate, locale)}
						</time>
						<a class="cactus-link" href={getProjectHref(project, locale)}>
							{project.data.name}
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
