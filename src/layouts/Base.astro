---
import { ClientRouter } from "astro:transitions";
import BackToTop from "@/components/BackToTop.astro";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { uiLanguageFromPath } from "@/i18n/ui";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
} = Astro.props;

// The <html lang> attribute follows the URL's locale prefix (ja/en) or the
// default UI language for unprefixed routes.
const htmlLang = uiLanguageFromPath(Astro.url.pathname);
---

<html class="scroll-smooth" lang={htmlLang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		<ThemeProvider />
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-3xl flex-col px-4 pt-16 font-mono text-sm font-normal antialiased sm:px-8"
	>
		<SkipLink />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<BackToTop />
		<ClientRouter />
	</body>
</html>
