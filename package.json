{
	"name": "astro-theme-cactus-multilingual",
	"type": "module",
	"version": "8.2.0",
	"packageManager": "pnpm@10.11.1",
	"private": false,
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"postinstall": "npm rebuild sharp --force",
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"translate": "node --env-file-if-exists=.env scripts/translate.mjs",
		"translate:force": "node --env-file-if-exists=.env scripts/translate.mjs --force",
		"translate:dry": "node --env-file-if-exists=.env scripts/translate.mjs --dry",
		"check": "astro check && biome check",
		"lint": "biome check --write",
		"format": "prettier -w . --cache"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.3.6",
		"@astrojs/mdx": "7.0.6",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@pagefind/component-ui": "^1.5.2",
		"@tailwindcss/vite": "4.3.3",
		"@viz-js/viz": "^3.29.0",
		"astro": "7.2.3",
		"astro-expressive-code": "^0.44.1",
		"astro-icon": "^1.2.0",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^8.0.6",
		"hastscript": "^9.0.0",
		"mdast-util-directive": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "^11.17.0",
		"satori": "0.29.0",
		"satori-html": "^0.3.2",
		"satteri": "^0.10.4",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.9",
		"@iconify-json/mdi": "^1.2.2",
		"@pagefind/default-ui": "^1.5.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.2.0",
		"autoprefixer": "^10.5.4",
		"js-yaml": "^5.3.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"reading-time": "^1.5.0",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"sharp": "^0.35.3"
	}
}
